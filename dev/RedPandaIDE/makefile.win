../../src/lyqueue.o: ../../src/lyqueue.c ../../inc/lydds_cfg.h ../../inc/lydds_api.h
	$(CC) -c "../../src/lyqueue.c" -o "../../src/lyqueue.o" $(CFLAGS)  -finput-charset=UTF-8 -fexec-charset=gbk

../../test/run_simple_examples.o: ../../test/run_simple_examples.c
	$(CC) -c "../../test/run_simple_examples.c" -o "../../test/run_simple_examples.o" $(CFLAGS)  -finput-charset=UTF-8 -fexec-charset=gbk

../../examples/bucket_basic.o: ../../examples/bucket_basic.c
	$(CC) -c "../../examples/bucket_basic.c" -o "../../examples/bucket_basic.o" $(CFLAGS)  -finput-charset=UTF-8 -fexec-charset=gbk

../../src/lybucket.o: ../../src/lybucket.c ../../inc/lydds_cfg.h ../../inc/lydds_api.h
	$(CC) -c "../../src/lybucket.c" -o "../../src/lybucket.o" $(CFLAGS)  -finput-charset=UTF-8 -fexec-charset=gbk

../../examples/pool_basic.o: ../../examples/pool_basic.c ../../inc/lydds_cfg.h ../../inc/lydds_api.h
	$(CC) -c "../../examples/pool_basic.c" -o "../../examples/pool_basic.o" $(CFLAGS)  -finput-charset=UTF-8 -fexec-charset=gbk

RedPandaIDE_private.res: RedPandaIDE_private.rc 
	$(WINDRES) -i "RedPandaIDE_private.rc" --input-format=rc -o "RedPandaIDE_private.res" -O coff $(WINDRESFLAGS) 


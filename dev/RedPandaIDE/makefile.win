# Project: RedPandaIDE
# Makefile created by Red Panda C++ 3.4.3279

CXX      = "g++.exe"
CC       = "gcc.exe"
WINDRES  = "windres.exe"
RM       = del /q /f
CD       = cd /d
LIBS     = "-Wl,--stack,12582912"
INCS     = 
CXXINCS  = 
CXXFLAGS = $(CXXINCS) "-g3" "-fno-ms-extensions" "-pipe" "-Wall" "-Werror=return-type" "-Werror=vla" "-D_DEBUG"
CFLAGS   = $(INCS) "-g3" "-fno-ms-extensions" "-pipe" "-Wall" "-Werror=implicit-int" "-Werror=return-type" "-Werror=vla" "-D_DEBUG"
NASM_FLAGS   =  "-f" "elf64" "-g"
WINDRESFLAGS = 
RES      = RedPandaIDE_private.res
OBJ      = ../../examples/queue_basic.o ../../src/lypool.o ../../src/lyset.o ../../examples/simple.o ../../examples/set_basic.o ../../src/lyqueue.o ../../test/run_simple_examples.o ../../examples/bucket_basic.o ../../src/lybucket.o ../../examples/pool_basic.o $(RES)
BIN      = RedPandaIDE.exe
LINKOBJ  = "../../examples/queue_basic.o" "../../src/lypool.o" "../../src/lyset.o" "../../examples/simple.o" "../../examples/set_basic.o" "../../src/lyqueue.o" "../../test/run_simple_examples.o" "../../examples/bucket_basic.o" "../../src/lybucket.o" "../../examples/pool_basic.o" "RedPandaIDE_private.res"
CLEANOBJ = "..\..\examples\queue_basic.o" "..\..\src\lypool.o" "..\..\src\lyset.o" "..\..\examples\simple.o" "..\..\examples\set_basic.o" "..\..\src\lyqueue.o" "..\..\test\run_simple_examples.o" "..\..\examples\bucket_basic.o" "..\..\src\lybucket.o" "..\..\examples\pool_basic.o" "RedPandaIDE_private.res" "RedPandaIDE.exe"

.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

clean: clean-custom
	-$(RM) $(CLEANOBJ) >NUL 2>&1

RedPandaIDE.exe: $(OBJ)

	$(CC) $(LINKOBJ) -o "RedPandaIDE.exe" $(LIBS)

../../examples/queue_basic.o: ../../examples/queue_basic.c
	$(CC) -c "../../examples/queue_basic.c" -o "../../examples/queue_basic.o" $(CFLAGS)  -finput-charset=UTF-8 -fexec-charset=gbk

../../src/lypool.o: ../../src/lypool.c ../../inc/lydds_cfg.h ../../inc/lydds_api.h
	$(CC) -c "../../src/lypool.c" -o "../../src/lypool.o" $(CFLAGS)  -finput-charset=UTF-8 -fexec-charset=gbk

../../src/lyset.o: ../../src/lyset.c ../../inc/lydds_cfg.h ../../inc/lydds_api.h
	$(CC) -c "../../src/lyset.c" -o "../../src/lyset.o" $(CFLAGS)  -finput-charset=UTF-8 -fexec-charset=gbk

../../examples/simple.o: ../../examples/simple.c ../../inc/lydds_cfg.h ../../inc/lydds_api.h
	$(CC) -c "../../examples/simple.c" -o "../../examples/simple.o" $(CFLAGS)  -finput-charset=UTF-8 -fexec-charset=gbk

